# Copy to backend/.env. Every setting is optional.

# Postgres connection string (Supabase, Neon, any Postgres 14+).
# Unset: a self-contained Postgres is started from backend/data/pgdata (needs the embedded-pg extra).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# auto = TimesFM when installed, else exponential smoothing. Or: timesfm | smoothing
# FORECAST_BACKEND=auto
# auto = cuda, then Apple GPU (mps), then cpu
# TIMESFM_DEVICE=auto
# TIMESFM_BATCH_SIZE=128
# TIMESFM_FLIP_INVARIANCE=false

# Run TimesFM in a separate service (uvicorn app.inference_service:app) and point the API at it.
# INFERENCE_URL=http://localhost:8100

# Pull new draws from the official sources on startup and every REFRESH_HOURS.
# AUTO_REFRESH=true
# REFRESH_HOURS=6

# Origins allowed to call the API directly (the Next.js app proxies /api, so this is rarely needed).
# CORS_ORIGINS=http://localhost:3000
